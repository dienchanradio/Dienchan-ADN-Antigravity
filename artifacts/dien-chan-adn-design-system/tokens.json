{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens extracted from the Diện Chẩn Kích Hoạt ADN landing page. Edit this file only; generated CSS and token modules are rebuilt from it.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#fdfbf7" },
      "foreground": { "$value": "#012c4e" },
      "border": { "$value": "#d9cbbd" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#012c4e" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#012c4e" },
      "primary": { "$value": "#cf5c78", "$description": "Rose CTA and emphasis color." },
      "primaryForeground": { "$value": "#fffaf2" },
      "secondary": { "$value": "#ede6d6", "$description": "Paper-tint surface used for alternating sections." },
      "secondaryForeground": { "$value": "#012c4e" },
      "muted": { "$value": "#ede6d6" },
      "mutedForeground": { "$value": "#426178" },
      "accent": { "$value": "#ead292", "$description": "Champagne highlight used for headlines, labels, and focus." },
      "accentForeground": { "$value": "#012c4e" },
      "destructive": { "$value": "#b44664" },
      "destructiveForeground": { "$value": "#fffaf2" },
      "input": { "$value": "#cdbda9" },
      "ring": { "$value": "#ead292" },
      "chart1": { "$value": "#cf5c78" },
      "chart2": { "$value": "#347aa8" },
      "chart3": { "$value": "#55b7b0" },
      "chart4": { "$value": "#ead292" },
      "chart5": { "$value": "#8d5bc4" },
      "sidebar": { "$value": "#012c4e" },
      "sidebarForeground": { "$value": "#ede6d6" },
      "sidebarBorder": { "$value": "#315872" },
      "sidebarPrimary": { "$value": "#cf5c78" },
      "sidebarPrimaryForeground": { "$value": "#fffaf2" },
      "sidebarAccent": { "$value": "#174b64" },
      "sidebarAccentForeground": { "$value": "#ead292" },
      "sidebarRing": { "$value": "#ead292" }
    },
    "dark": {
      "background": { "$value": "#012c4e" },
      "foreground": { "$value": "#fdfbf7" },
      "border": { "$value": "#315872" },
      "card": { "$value": "#073e5e" },
      "cardForeground": { "$value": "#fdfbf7" },
      "popover": { "$value": "#073e5e" },
      "popoverForeground": { "$value": "#fdfbf7" },
      "primary": { "$value": "#cf5c78" },
      "primaryForeground": { "$value": "#fffaf2" },
      "secondary": { "$value": "#ede6d6" },
      "secondaryForeground": { "$value": "#012c4e" },
      "muted": { "$value": "#174b64" },
      "mutedForeground": { "$value": "#c8d0cf" },
      "accent": { "$value": "#ead292" },
      "accentForeground": { "$value": "#012c4e" },
      "destructive": { "$value": "#b44664" },
      "destructiveForeground": { "$value": "#fffaf2" },
      "input": { "$value": "#315872" },
      "ring": { "$value": "#ead292" },
      "chart1": { "$value": "#cf5c78" },
      "chart2": { "$value": "#347aa8" },
      "chart3": { "$value": "#55b7b0" },
      "chart4": { "$value": "#ead292" },
      "chart5": { "$value": "#8d5bc4" },
      "sidebar": { "$value": "#012c4e" },
      "sidebarForeground": { "$value": "#ede6d6" },
      "sidebarBorder": { "$value": "#315872" },
      "sidebarPrimary": { "$value": "#cf5c78" },
      "sidebarPrimaryForeground": { "$value": "#fffaf2" },
      "sidebarAccent": { "$value": "#174b64" },
      "sidebarAccentForeground": { "$value": "#ead292" },
      "sidebarRing": { "$value": "#ead292" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "sans-serif"],
        "$description": "Clear, friendly UI and body copy."
      },
      "serif": {
        "$value": ["Fraunces", "Georgia", "serif"],
        "$description": "Editorial display face for hero and section headlines."
      },
      "mono": {
        "$value": ["Space Mono", "monospace"],
        "$description": "Compact uppercase eyebrow labels and metadata."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1rem",
      "$description": "Soft editorial card radius; pill controls use a full radius."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Four-pixel base rhythm used for compact controls and generous section spacing."
    }
  }
}